# =============================================================================
# FRONTEND — these go in `.env.local` (Next.js), NOT in the backend's `.env`.
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the JS bundle at BUILD
# time, not read at server-start time. If you change one, you must rebuild
# (and redeploy) the frontend — restarting the running process is not enough.
# =============================================================================

# Base URL of the Django backend API (no trailing slash).
# NEXT_PUBLIC_API_URL=https://api.nyrajewellery.com/api

# Canonical production origin, used for the sitemap/robots.txt/OpenGraph
# URLs. Falls back to http://localhost:3000 if unset.
# NEXT_PUBLIC_SITE_URL=https://nyrajewellery.com


# =============================================================================
# BACKEND — everything below goes in `.env` (same directory as manage.py),
# NOT in the frontend's `.env.local`. `.env` is gitignored — never commit it.
# =============================================================================

# Copy this file to `.env` (same directory as manage.py) and fill in real
# values. `.env` is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# "development" unlocks a safe fallback SECRET_KEY and DEBUG defaults.
# Any other value (e.g. "production") requires DJANGO_SECRET_KEY and
# DJANGO_DEBUG to be set explicitly, or the app refuses to start.
DJANGO_ENV=production
DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated. Must match the domain(s) Django is served on.
DJANGO_ALLOWED_HOSTS=api.nyrajewellery.com

# ---------------------------------------------------------------------------
# Database (Postgres by default; set DB_ENGINE=sqlite for local/dev only)
# ---------------------------------------------------------------------------
DB_ENGINE=postgres
DB_NAME=nyra
DB_USER=nyra
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# CORS / CSRF — the frontend's real origin(s), comma-separated
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://nyrajewellery.com
# Defaults to CORS_ALLOWED_ORIGINS if unset — only override if the trusted
# set needs to differ from the CORS-allowed set.
CSRF_TRUSTED_ORIGINS=https://nyrajewellery.com

# ---------------------------------------------------------------------------
# Auth cookies
# ---------------------------------------------------------------------------
JWT_AUTH_COOKIE=nyra_access_token
JWT_REFRESH_COOKIE=nyra_refresh_token
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# "Lax" works if frontend and backend share the same registrable domain
# (e.g. nyrajewellery.com and api.nyrajewellery.com — same site, different
# subdomain). Use "None" only if they are genuinely cross-site; forces
# Secure cookies automatically when you do.
JWT_COOKIE_SAMESITE=Lax
# Leave unset unless you need the cookie shared across subdomains
# (e.g. ".nyrajewellery.com").
JWT_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# HTTPS hardening — opt-in, see settings.py comments before enabling
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Only set these True once every subdomain you have is permanently HTTPS-only
# — SECURE_HSTS_PRELOAD in particular is very hard to reverse once submitted.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Media storage (ImageKit — required, the app will not start without these)
# ---------------------------------------------------------------------------
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
TIME_ZONE=Africa/Algiers
PAGE_SIZE=12

# ---------------------------------------------------------------------------
# Used only by `python manage.py create_admin` (one-time setup)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nyrajewellery.com
ADMIN_PASSWORD=
